#: smartdns.js:1606
msgid "NFTset name, format: [#[4|6]:[family#table#set]]"
msgstr "نام NFTset. قالب: [#[4|6]:[family#table#set]]"

#: smartdns.js:445 smartdns.js:466 smartdns.js:644 smartdns.js:1238
#: smartdns.js:1404 smartdns.js:1619
msgid "NFTset name format error, format: [#[4|6]:[family#table#set]]"
msgstr "قالب نام NFTset نامعتبر است. قالب صحیح: [#[4|6]:[family#table#set]]"

#: smartdns.js:453
msgid "No Speed NFTset Name"
msgstr "نام NFTset در صورت ناموفق‌بودن سنجش سرعت"

