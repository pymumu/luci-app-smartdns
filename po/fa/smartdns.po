msgstr "شماره درگاه سرور DoT در SmartDNS."

#: smartdns.js:297
msgid "DOH Server"
msgstr "سرور DoH"

#: smartdns.js:297
msgid "Enable DOH DNS Server"
msgstr "فعال‌سازی سرور DNS روی DoH"

msgid "Enable Discovery of Designated Resolvers for enabled local DNS services."
msgstr "قابلیت کشف حل‌کننده‌های DNS تعیین‌شده را برای سرویس‌های DNS محلی فعال‌شده، فعال می‌کند."

